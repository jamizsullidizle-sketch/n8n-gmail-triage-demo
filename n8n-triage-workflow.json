    {
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
      "name": "Classify (keyword rules)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ],
      "parameters": {
        "jsCode": "// ---- Keyword triage rules (shared by the n8n Code node and the local test) ----\n// Edit these lists to tune the triage. Order of CATEGORY_RULES = priority on ties.\nconst CATEGORY_RULES = {\n  'Spam-Other': [\n    'unsubscribe', 'newsletter', 'seo services', 'guest post', 'backlinks', 'crypto',\n    'bitcoin', 'you have won', 'lottery', 'limited time offer', 'act now', 'viagra',\n    'rank #1 on google', 'webinar invitation', 'no-reply', 'noreply'\n  ],\n  'Billing': [\n    'invoice', 'receipt', 'payment', 'refund', 'charged', 'charge', 'billing',\n    'subscription', 'order #', 'order number', 'overdue', 'credit note', 'vat',\n    'rechnung', 'zahlung'\n  ],\n  'Consultancy': [\n    'quote', 'quotation', 'proposal', 'consulting', 'consultation', 'consultancy',\n    'project', 'audit', 'migration', 'rollout', 'pricing for', 'how much would',\n    'interested in your services', 'hire you', 'book a call', 'discovery call',\n    'angebot', 'beratung'\n  ],\n  'Support': [\n    'not working', \"can't\", 'cannot', 'error', 'broken', 'help', 'how do i', 'how to',\n    'issue', 'problem', 'stopped', 'password', 'login', 'locked out', 'reset',\n    'not receiving', 'bounce', 'printer', 'vpn', 'outlook', 'urgent', 'down',\n    'funktioniert nicht', 'fehler', 'hilfe'\n  ]\n};\n\n// Words in the subject count double: subjects are short and usually say what the email is.\nconst SUBJECT_WEIGHT = 2;\n\nfunction countHits(haystack, keywords) {\n  const hits = [];\n  for (const kw of keywords) {\n    if (haystack.includes(kw)) hits.push(kw);\n  }\n  return hits;\n}\n\nfunction extractDetails(text) {\n  const details = {};\n  const inv = text.match(/\\b(?:invoice|inv|rechnung)\\s*(?:no\\.?|number|nr\\.?|#)?\\s*[:#]?\\s*([A-Z0-9][A-Z0-9\\-\\/]{2,})/i);\n  if (inv) details.invoiceNumber = inv[1];\n  const ord = text.match(/\\border\\s*(?:no\\.?|number|nr\\.?|#)?\\s*[:#]?\\s*([A-Z0-9][A-Z0-9\\-]{2,})/i);\n  if (ord) details.orderNumber = ord[1];\n  const amt = text.match(/(?:€|\\$|£|EUR|USD|GBP)\\s?(\\d{1,3}(?:[.,]\\d{3})*(?:[.,]\\d{2})?)|(\\d{1,3}(?:[.,]\\d{3})*(?:[.,]\\d{2})?)\\s?(?:€|EUR)/i);\n  if (amt) details.amount = (amt[0] || '').trim();\n  return details;\n}\n\nfunction classifyEmail({ fromAddress = '', subject = '', body = '' }) {\n  const s = String(subject).toLowerCase();\n  const b = String(body).toLowerCase();\n  const f = String(fromAddress).toLowerCase();\n\n  const scores = {};\n  const matched = {};\n  for (const [cat, kws] of Object.entries(CATEGORY_RULES)) {\n    const subjHits = countHits(s, kws);\n    const bodyHits = countHits(b + ' ' + f, kws);\n    scores[cat] = subjHits.length * SUBJECT_WEIGHT + bodyHits.length;\n    matched[cat] = [...new Set([...subjHits, ...bodyHits])];\n  }\n\n  // Pick the highest score; ties are broken by the order of CATEGORY_RULES above.\n  let category = 'Spam-Other';\n  let best = 0;\n  for (const cat of Object.keys(CATEGORY_RULES)) {\n    if (scores[cat] > best) { best = scores[cat]; category = cat; }\n  }\n  // Nothing matched at all -> treat as Support so a human still sees it (safer than hiding it as spam).\n  const confidence = best === 0 ? 'none' : best >= 3 ? 'high' : 'low';\n  if (best === 0) category = 'Support';\n\n  return {\n    category,\n    confidence,\n    needsHumanReview: confidence !== 'high',\n    scores,\n    matchedKeywords: matched[category] || [],\n    details: extractDetails(subject + '\\n' + body)\n  };\n}\n\n\n// ---- n8n wrapper: map Gmail Trigger fields -> classifier -> clean output ----\nconst out = [];\nfor (const item of $input.all()) {\n  const m = item.json;\n  const sender = (m.from && m.from.value && m.from.value[0]) || {};\n  const body = m.text || m.textAsHtml || m.snippet || '';\n  const r = classifyEmail({ fromAddress: sender.address || '', subject: m.subject || '', body });\n  out.push({ json: {\n    messageId: m.id,\n    threadId: m.threadId,\n    receivedAt: m.date || new Date().toISOString(),\n    fromName: sender.name || '',\n    fromEmail: sender.address || '',\n    subject: m.subject || '(no subject)',\n    snippet: String(body).slice(0, 300),\n    category: r.category,\n    confidence: r.confidence,\n    needsHumanReview: r.needsHumanReview,\n    matchedKeywords: r.matchedKeywords.join(', '),\n    invoiceNumber: r.details.invoiceNumber || '',\n    orderNumber: r.details.orderNumber || '',\n    amount: r.details.amount || '',\n    classifiedBy: 'keywords'\n  }, pairedItem: item.pairedItem });\n}\nreturn out;\n"
      },
      "notes": "Keyword rules + invoice/order/amount extraction. Same code as src/classify.js (tested in tests/)."
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000004",
      "name": "[OPTIONAL] LLM classify (OpenAI)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "disabled": true,
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: 'gpt-4o-mini', temperature: 0, response_format: { type: 'json_object' }, messages: [ { role: 'system', content: 'Classify this email for an IT support & consultancy business. Reply as JSON {\"category\": \"Support|Consultancy|Billing|Spam-Other\", \"invoiceNumber\": \"\", \"orderNumber\": \"\", \"amount\": \"\"}.' }, { role: 'user', content: 'Subject: ' + $json.subject + '\\n\\n' + $json.snippet } ] }) }}",
        "options": {}
      },
      "credentials": {
        "openAiApi": {
          "id": "REPLACE_WITH_OPENAI_CREDENTIAL_ID",
          "name": "OpenAI account (optional)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput",
      "notes": "OPTIONAL – disabled by default. Enable this and the next node to let an LLM decide the category. If the API fails, the keyword result is kept."
    },
    {
      "id": "a1b2c3d4-0000-4000-8000-000000000005",
      "name": "[OPTIONAL] Use LLM answer if valid",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ],
      "disabled": true,
      "parameters": {
        "jsCode": "// Merge the LLM answer into the keyword result; fall back to keywords on any problem.\nconst allowed = ['Support', 'Consultancy', 'Billing', 'Spam-Other'];\nreturn $input.all().map((item, i) => {\n  const base = $('Classify (keyword rules)').all()[i].json;\n  try {\n    const llm = JSON.parse(item.json.choices[0].message.content);\n    if (allowed.includes(llm.category)) {\n      return { json: { ...base, category: llm.category, classifiedBy: 'llm',\n        invoiceNumber: base.invoiceNumber || llm.invoiceNumber || '',\n        orderNumber: base.orderNumber || llm.orderNumber || '',\n        amount: base.amount || llm.amount || '' } };\n    }\n  } catch (e) { /* keep keyword result */ }\n  return { json: base };\n});"
      }
    },
